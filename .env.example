# Copy this file to .env for local compose runs.
# Replace every local-dev-* value before exposing any service outside localhost.

MQTT_ENABLED=true
MQTT_USERNAME=haiyu_cloud_consumer
MQTT_PASSWORD=local-dev-mqtt-password
MQTT_EDGE_USERNAME=edge-01
MQTT_EDGE_PASSWORD=local-dev-edge-password
MQTT_REQUIRE_CREDENTIALS=true
MQTT_EVENT_HMAC_SECRET=local-dev-event-hmac-secret
MQTT_ALLOWED_DEVICE_IDS=edge-01
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_CERT=
MQTT_TLS_CLIENT_CERT=
MQTT_TLS_CLIENT_KEY=
MQTT_TLS_INSECURE=false
MQTT_AUTO_RECONNECT=true
MQTT_RECONNECT_MAX_ATTEMPTS=

INFLUXDB_USERNAME=haiyu
INFLUXDB_PASSWORD=local-dev-influxdb-password
INFLUXDB_ORG=haiyu
INFLUXDB_BUCKET=haiyu
INFLUXDB_TOKEN=local-dev-influxdb-token

API_BIND_HOST=127.0.0.1
API_PORT=8000
API_TOKEN=local-dev-api-token
API_TOKENS=
ALLOW_UNAUTHENTICATED=false
CORS_ORIGINS=http://localhost:5173
WEBSOCKET_MAX_CONNECTIONS=100
WEBSOCKET_ALLOW_QUERY_TOKEN=false

FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Empty API_TOKEN no longer opens protected endpoints by default.
# Use ALLOW_UNAUTHENTICATED=true only for isolated local development.
# Keep WEBSOCKET_ALLOW_QUERY_TOKEN=false unless debugging an isolated client.
AUTH_MODE=placeholder-risk
